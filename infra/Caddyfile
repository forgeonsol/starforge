# Caddy gets and renews the Let's Encrypt certificate by itself. DOMAIN and ACME_EMAIL come from infra/.env.
{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_header 10s
			read_body 15s
			write 60s
			idle 2m
		}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	header -Server
	reverse_proxy app:3000 {
		# Caddy sets X-Forwarded-For to the real client itself; drop anything else a client could forge
		header_up -Cf-Connecting-Ip
		header_up -X-Real-Ip
	}
	log {
		output stdout
		format json
	}
}
