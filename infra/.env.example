# Copy to infra/.env and fill in.
DOMAIN=forge.example.com
ACME_EMAIL=you@example.com
# how many daily database backups to keep inside the data volume
BACKUP_KEEP=14
BACKUP_HOURS=24
# published at https://DOMAIN/.well-known/security.txt so researchers know where to report problems
SECURITY_CONTACT=mailto:security@forge.example.com
# an IP collecting this many rejected API calls within 10 minutes is blocked from the API for BAN_MINUTES
BAN_STRIKES=40
BAN_MINUTES=30
